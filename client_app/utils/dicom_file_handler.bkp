from pathlib import Path
import zipfile
from django.core.files.storage import default_storage
from django.conf import settings
from django.core.exceptions import ValidationError
from django.utils.translation import gettext_lazy as _
from .file_path_generator import get_processing_dir_path, sanitize_id
from .zip_extractor import extract_and_process_dicom

class DicomFileHandler:
    def handle_uploaded_file(self, file, patient_id):
        """
        Handle the file upload process and unzip contents.
        """
        if not file:
            return None, None

        try:
            filename = f"patient_upload.zip"
            # Save the file
            saved_file_path = default_storage.save(filename,file)
            
            # Get processing directory path and extract zip contents
            processing_dir = get_processing_dir_path(patient_id)
            
            # Process the file
            extract_and_process_dicom(saved_file_path, processing_dir, patient_id)
            
            return saved_file_path, processing_dir
            
        except zipfile.BadZipFile:
            raise ValidationError(_('The uploaded file is not a valid ZIP file.'))
        except Exception as e:
            raise ValidationError(_(f'Error processing file: {str(e)}'))