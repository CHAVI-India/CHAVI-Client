from pathlib import Path
import re
from django.conf import settings

def sanitize_id(patient_id):
    """
    Remove special characters from patient ID and replace with underscore.
    Args:
        patient_id: Original patient ID
    Returns:
        str: Sanitized patient ID with special characters replaced by underscores
    """
    # Replace any non-alphanumeric character with underscore
    sanitized = re.sub(r'[^a-zA-Z0-9]', '_', str(patient_id))
    # Replace multiple consecutive underscores with a single underscore
    sanitized = re.sub(r'_+', '_', sanitized)
    return sanitized

def generate_zip_file_path(filename):
    """
    Generate path for the uploaded zip file.
    Returns relative path from MEDIA_ROOT.
    """
    # media_root = Path(settings.MEDIA_ROOT)
    # dicom_path = media_root / 'dicom_files'
    
    # dicom_path.mkdir(parents=True, exist_ok=True)
    
    return filename

def get_processing_dir_path(patient_id):
    """
    Generate the path for patient's processing directory.
    Returns relative path from MEDIA_ROOT.
    """
    # Sanitize the patient ID
    clean_id = sanitize_id(patient_id)
    
    # Create processing directory
    processing_path = Path(settings.MEDIA_ROOT) / 'dicom_processing_folder' / f"{clean_id}"
    processing_path.mkdir(parents=True, exist_ok=True)
    
    return str(Path('dicom_processing_folder') / f"{clean_id}")