import zipfile
from pathlib import Path
from django.conf import settings

def extract_zip_file(zip_file_path, extract_to_path):
    """
    Extract contents of a zip file to specified directory.
    Args:
        zip_file_path: Relative path to the zip file from MEDIA_ROOT
        extract_to_path: Relative path to extraction directory from MEDIA_ROOT
    """
    # Convert paths to Path objects relative to MEDIA_ROOT
    full_zip_path = Path(settings.MEDIA_ROOT) / zip_file_path
    full_extract_path = Path(settings.MEDIA_ROOT) / extract_to_path
    
    # Extract the zip file
    with zipfile.ZipFile(full_zip_path, 'r') as zip_ref:
        zip_ref.extractall(full_extract_path)